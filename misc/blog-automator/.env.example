# ── Tavily (Research) ──────────────────────────────────────────────────────
# Get your key at https://app.tavily.com
TAVILY_API_KEY=tvly-your-key-here

# ── Anthropic (Drafting) ───────────────────────────────────────────────────
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model to use for drafting (defaults to claude-sonnet-4-6)
CLAUDE_MODEL=claude-sonnet-4-6

# Model to use for critic review (defaults to claude-3-5-sonnet-20241022)
# The critic runs a separate LLM call evaluating SEO, structure, and engagement.
CLAUDE_CRITIC_MODEL=claude-3-5-sonnet-20241022

# ── CMS Publishing (optional) ─────────────────────────────────────────────
# Leave blank to use the built-in publish simulator
# Ghost Admin API format: <id>:<secret>
CMS_API_URL=http://localhost:2368/ghost/api/admin
CMS_API_KEY=

# WordPress REST API example:
# CMS_API_URL=https://your-site.com/wp-json/wp/v2
# CMS_API_KEY=base64(username:application-password)
