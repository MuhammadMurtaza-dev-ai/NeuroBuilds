# ─────────────────────────────────────────────────────────────────────────────
# NeuroBuilds AI Backend — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Google Gemini (required — LLM + embeddings) ───────────────────────────────
# Get keys at https://aistudio.google.com/app/apikey
#
# Pool mode (recommended): set GEMINI_KEY_1 through GEMINI_KEY_10.
# GeminiKeyManager rotates across the pool with 60-req/min per-key windows,
# Fisher-Yates load balancing, and transparent 429-retry with key rotation.
#
GEMINI_KEY_1=your-first-gemini-api-key
# GEMINI_KEY_2=your-second-gemini-api-key
# GEMINI_KEY_3=your-third-gemini-api-key
# ... up to GEMINI_KEY_10
#
# Single-key fallback: if no GEMINI_KEY_N vars are set, GOOGLE_API_KEY is used.
GOOGLE_API_KEY=your-google-api-key-here
#
# Model used in intent_node, response_node, and blog_automator pipeline.
# Options: gemini-2.0-flash | gemini-2.0-flash-lite | gemini-1.5-pro
GEMINI_MODEL=gemini-2.0-flash
# Bound each Gemini call so a throttled request fails fast (Gemini free tier is
# ~20 requests/day for flash-lite). Defaults: 2 retries, 40s timeout.
# GEMINI_MAX_RETRIES also governs per-model retries on transient 503/429 errors
# in gemini_manager.py (blog automator / market intel) before falling back.
GEMINI_MAX_RETRIES=2
GEMINI_TIMEOUT_S=40
# Ordered fallback model chain for gemini_manager.py when the requested model is
# overloaded (503 "high demand"). Comma-separated; the requested GEMINI_MODEL is
# always tried first. Leave unset to use the built-in chain.
# GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-2.0-flash-lite,gemini-1.5-flash

# ── Primary chat/generation LLM provider (Groq) ───────────────────────────────
# NOTE: despite the FALLBACK_LLM_* prefix (kept for backward compatibility), this
# provider is now tried FIRST for chat/narration/structured calls; Gemini above is
# the fallback. Gemini is still the ONLY embedding provider (Groq has no embeddings
# API), so RAG / semantic-cache paths always need GOOGLE_API_KEY / a GEMINI_KEY_N.
# Any OpenAI-compatible API. Recommended: Groq (free + fast) — https://console.groq.com/keys
# Leave FALLBACK_LLM_API_KEY empty to disable (then Gemini becomes primary again).
# Requires `pip install langchain-openai`.
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_BASE_URL=https://api.groq.com/openai/v1
FALLBACK_LLM_MODEL=llama-3.3-70b-versatile
# Wall-clock bound + circuit-breaker cooldown (seconds) for the primary provider.
FALLBACK_LLM_TIMEOUT_S=40
# FALLBACK_LLM_COOLDOWN_S=120

# ── YouTube Data API v3 (component review proxy — GET /api/components/reviews) ─
# Enables server-side YouTube review lookups with 7-day MongoDB TTL cache.
# Get a key at https://console.cloud.google.com — enable "YouTube Data API v3".
YOUTUBE_API_KEY=your-youtube-data-api-v3-key

# ── Tavily (Node 1 — live price/availability web search) ─────────────────────
# Get a free key at https://app.tavily.com
TAVILY_API_KEY=your-tavily-api-key

# ── MongoDB Atlas (Node 2 — RAG hardware database + semantic cache) ───────────
# Populate the collection from GPU_Exhaustive_Database.csv and CPU/mobo data.
# Create a Vector Search index named "vector_index" on the "embedding" field.
MONGODB_ATLAS_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=neurobuilds
MONGODB_COLLECTION=hardware_specs
MONGODB_VECTOR_INDEX=vector_index
MONGODB_CATALOG_COLLECTION=hardware_catalog
# Firestore-mirrored listings collection used by GET /api/marketplace/search.
MONGODB_LISTINGS_COLLECTION=listings
# Semantic LLM cache — collection is created automatically on first use.
# You must create a Vector Search index named "semantic_cache_index" on the
# "embedding" field (768 dims, cosine) in the Atlas UI before the first request.
MONGODB_CACHE_COLLECTION=semantic_cache
# Socket-level timeout (ms) for all Mongo clients. pymongo/Motor default to NO
# timeout here, so a mid-query network stall hangs the calling thread forever
# instead of raising — this bounds it so the AI pipeline degrades gracefully
# instead of the backend going unresponsive until it's restarted.
MONGO_SOCKET_TIMEOUT_MS=10000
# Per-call wall-clock bound (seconds) on budget_allocation_node's DB query and
# market_node's market-intel read, layered on top of MONGO_SOCKET_TIMEOUT_MS.
MONGO_QUERY_TIMEOUT_S=10
MARKET_TIMEOUT_S=6

# ── Firebase Admin SDK (required by require_admin / require_auth / optional_auth) ─
# Path to a service-account JSON key file (relative paths resolve against this
# file's directory). On GCP this can be left unset — Application Default
# Credentials are used instead.
FIREBASE_SERVICE_ACCOUNT_PATH=your-firebase-adminsdk-key.json
FIREBASE_PROJECT_ID=your-firebase-project-id
# Wall-clock bound (seconds) on Firebase ID token verification. check_revoked=True
# makes a network call to Google's Identity Toolkit API on top of the local
# cert/signature check; that call has no timeout of its own, so a DNS/network
# blip reaching Google can retry for 20-30+ seconds — past most frontend request
# timeouts — making a live backend look "unreachable". This bounds it so a
# network hiccup fails fast with a clear 503 instead.
FIREBASE_AUTH_TIMEOUT_S=10

# ── CORS (FastAPI backend) ────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Add production/staging URLs here.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── WhatsApp OTP Gateway ──────────────────────────────────────────────────────
# URL of the local WhatsApp gateway microservice (backend/whatsapp-gateway/).
# Default is http://127.0.0.1:3001 — only change if you run the gateway on a
# different port or host.
WHATSAPP_GATEWAY_URL=http://127.0.0.1:3001
# Shared secret for the gateway's /send-otp endpoint.  Must match GATEWAY_SECRET
# set in the gateway process.  Use a long random string (e.g. openssl rand -hex 32).
GATEWAY_SECRET=change-me-to-a-long-random-string
