# ─────────────────────────────────────────────────────────────────────────────
# NeuroBuilds AI Backend — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── OpenAI (required — LLM + embeddings) ─────────────────────────────────────
OPENAI_API_KEY=sk-...
# Model used in response_node. gpt-4o-mini is cost-effective for dev/demo.
# Options: gpt-4o-mini | gpt-4o | gpt-4-turbo
OPENAI_MODEL=gpt-4o-mini

# ── Tavily (Node 1 — live price/availability web search) ─────────────────────
# Get a free key at https://app.tavily.com
TAVILY_API_KEY=tvly-...

# ── MongoDB Atlas (Node 2 — RAG hardware database + semantic cache) ───────────
# Populate the collection from GPU_Exhaustive_Database.csv and CPU/mobo data.
# Create a Vector Search index named "vector_index" on the "embedding" field.
MONGODB_ATLAS_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=neurobuilds
MONGODB_COLLECTION=hardware_specs
MONGODB_VECTOR_INDEX=vector_index
MONGODB_CATALOG_COLLECTION=hardware_catalog
# Semantic LLM cache — collection is created automatically on first use.
# You must create a Vector Search index named "semantic_cache_index" on the
# "embedding" field (1536 dims, cosine) in the Atlas UI before the first request.
MONGODB_CACHE_COLLECTION=semantic_cache

# ── CORS (FastAPI backend) ────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Add production/staging URLs here.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── WhatsApp OTP Gateway ──────────────────────────────────────────────────────
# URL of the local WhatsApp gateway microservice (backend/whatsapp-gateway/).
# Default is http://127.0.0.1:3001 — only change if you run the gateway on a
# different port or host.
WHATSAPP_GATEWAY_URL=http://127.0.0.1:3001
# Shared secret for the gateway's /send-otp endpoint.  Must match GATEWAY_SECRET
# set in the gateway process.  Use a long random string (e.g. openssl rand -hex 32).
GATEWAY_SECRET=change-me-to-a-long-random-string
